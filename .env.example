# 复制为 .env 后填写真实值；不要把 .env 提交到仓库。
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MONGO_URI=mongodb://127.0.0.1:27017/furry_drama_tracker

# 必填：至少 32 字符的随机字符串
JWT_SECRET=
# 建议单独生成；为空时回退 JWT_SECRET（兼容旧数据，不推荐）
ENCRYPTION_KEY=
# 建议单独生成；为空时由 JWT_SECRET 派生
ALTCHA_HMAC_KEY=

# 初始超级管理员（仅 seed-admin 使用）
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_ACCOUNT_ID=admin
SUPERADMIN_PASSWORD=

# 仅 development 生效：跳过新设备/邮箱验证
DEMO_EMAILS=demo@furry09.com

# 邮件服务
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=兽剧聚合平台

# Web Push（当前后端未实现发送，可留空）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 仅开发调试使用；生产环境必须留空
DEV_API_TOKEN=
SKIP_RATE_LIMIT=

# 客户端 IP 识别（代理标头信任策略；同名 ini [server] 键的 env 覆盖，均可留空）
# 是否信任反向代理标头；缺省跟随 NODE_ENV（生产=信任、开发=不信任），1/true、0/false
TRUST_PROXY_HEADERS=
# 标头清单（逗号分隔，按序取首个有效 IP）；缺省 CF-Connecting-IP,X-Real-IP,X-Forwarded-For
PROXY_IP_HEADERS=
# 受信代理来源（IP/CIDR，逗号分隔）；缺省不配=信任全部来源；本机反代拓扑建议 127.0.0.1, ::1
TRUSTED_PROXIES=
# 单一无条件最高优先标头（不校验来源与格式，慎用）；缺省不启用
PROXY_TRUSTED_PLATFORM=

# 用户名（登录名）策略
# 黑名单补充词表（逗号分隔，与内置词表合并做子串匹配：用户名包含任一关键词即拒绝）
USERNAME_BLACKLIST=
# 改名冷却天数（默认 7）
LOGIN_NAME_COOLDOWN_DAYS=
# 旧用户名保留天数（默认 90，期间他人不可注册该名）
LOGIN_NAME_RESERVE_DAYS=

# Passkey（WebAuthn）；留空时从 FRONTEND_URL/SITE_URL 的域名推导
# Relying Party ID（通常为站点裸域名，如 furry09.com）
WEBAUTHN_RP_ID=
# 注册时展示的站点名（缺省用 EMAIL_FROM_NAME 或域名）
WEBAUTHN_RP_NAME=
# 允许的仪式来源（逗号分隔完整 origin；开发环境自动追加 localhost:3000-3002）
WEBAUTHN_ORIGINS=

# QQ 互联（预留：配置后才启用 /api/auth/qq/*，当前实现返回 501）
QQ_APPID=
QQ_APPKEY=
