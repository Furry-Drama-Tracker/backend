# 复制为 .env 后填写真实值；不要把 .env 提交到仓库。
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MONGO_URI=mongodb://127.0.0.1:27017/furry_drama_tracker

# 必填：至少 32 字符的随机字符串
JWT_SECRET=
# 建议单独生成；为空时回退 JWT_SECRET（兼容旧数据，不推荐）
ENCRYPTION_KEY=
# 建议单独生成；为空时由 JWT_SECRET 派生
ALTCHA_HMAC_KEY=

# 初始超级管理员（仅 seed-admin 使用）
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_ACCOUNT_ID=admin
SUPERADMIN_PASSWORD=

# 仅 development 生效：跳过新设备/邮箱验证
DEMO_EMAILS=demo@furry09.com

# 邮件服务
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=兽剧聚合平台

# Web Push（当前后端未实现发送，可留空）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 仅开发调试使用；生产环境必须留空
DEV_API_TOKEN=
SKIP_RATE_LIMIT=
